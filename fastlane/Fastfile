# CI release tooling. Lanes read an App Store Connect API key from:
#   ASC_KEY_ID, ASC_ISSUER_ID - from App Store Connect > Users and Access > Integrations
#   ASC_KEY_PATH              - path to the downloaded AuthKey_<id>.p8
#
# Signing is cloud-managed: the archive is built unsigned and Xcode signs
# the export with Apple's cloud-managed distribution certificate using the
# API key, so no certificates or profiles live in CI.

default_platform(:ios)

platform :ios do
  def asc_credentials
    key_id, issuer_id, key_path = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].map { |name| ENV.fetch(name) }
    # Lanes run in fastlane/; resolve a relative key path from the repo root.
    [key_id, issuer_id, File.expand_path(key_path, "..")]
  end

  # Turns release-please's markdown changelog into plain App Store
  # "What's New" text: one bullet per change, without links or scopes.
  def app_store_notes(changelog)
    notes = changelog.lines.filter_map do |line|
      next unless (entry = line[/^\* (.+)/, 1])

      entry = entry.gsub(/\s*\(\[[^\]]+\]\([^)]+\)\)/, "").sub(/\A\*\*[^*]+:\*\*\s*/, "")
      "• #{entry[0].upcase}#{entry[1..]}"
    end
    return notes.join("\n") unless notes.empty?

    UI.important("No changelog entries found in the release notes; using a generic note") unless changelog.strip.empty?
    "Bug fixes and improvements."
  end

  # App Store Connect stops accepting builds for a version once it's been
  # submitted, so commits after a release tag build as the next patch until
  # release-please bumps the real version.
  def testflight_version
    version = File.read("../Configuration/Version.xcconfig")[/^MARKETING_VERSION = (\S+)/, 1]
    # Both lightweight and annotated tags; for annotated, the peeled ^{}
    # line (the commit) sorts last.
    refs = sh("git", "ls-remote", "origin", "refs/tags/v#{version}", "refs/tags/v#{version}^{}", log: false)
    tag_commit = refs.lines.last&.split&.first
    return version if tag_commit.nil? || tag_commit == last_git_commit[:commit_hash]

    major, minor, patch = version.split(".").map(&:to_i)
    "#{major}.#{minor}.#{patch + 1}"
  end

  before_all do
    key_id, issuer_id, key_path = asc_credentials
    # Stored in the lane context, where the App Store Connect actions pick it up.
    app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path)
  end

  desc "Build the app and upload it to TestFlight for internal testers"
  lane :beta do
    key_id, issuer_id, key_path = asc_credentials
    version = testflight_version
    build_number = latest_testflight_build_number(initial_build_number: 0) + 1
    UI.message("Building #{version} (#{build_number})")

    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path.shellescape} " \
           "-authenticationKeyID #{key_id.shellescape} -authenticationKeyIssuerID #{issuer_id.shellescape}"

    build_app(
      project: "JustASimpleDice.xcodeproj",
      scheme: "JustASimpleDice",
      configuration: "Release",
      export_method: "app-store",
      skip_codesigning: true,
      skip_profile_detection: true,
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: auth,
      export_options: {
        signingStyle: "automatic",
        teamID: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
        manageAppVersionAndBuildNumber: false,
      },
      output_directory: "build",
    )

    upload_to_testflight(
      changelog: last_git_commit[:message].lines.first.strip,
      distribute_external: false,
    )

    # Lets a later CI job submit this exact build for review.
    File.write(ENV["GITHUB_OUTPUT"], "build_number=#{build_number}\n", mode: "a") if ENV["GITHUB_OUTPUT"]
  end

  # The listing lives in fastlane/metadata and is uploaded by submit, so
  # edit it in a PR rather than in App Store Connect. Run this once to
  # bootstrap it from the live version (or to pull in changes made in
  # App Store Connect), then commit the result.
  desc "Download the live App Store listing text into fastlane/metadata"
  lane :download_listing do
    # deliver's CLI reads the key (as JSON) from this variable; passing it
    # to sh instead would echo the private key into the log.
    ENV["APP_STORE_CONNECT_API_KEY"] = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY].to_json
    Dir.chdir("..") do
      # Downloads the newest App Store version: the live one, or the next
      # one if it's already been created in App Store Connect.
      sh("fastlane", "deliver", "download_metadata", "--force", "--metadata_path", "fastlane/metadata")
    end
  end

  # fastlane submit version:1.1.0 build_number:42, with the release-please
  # changelog in RELEASE_NOTES.
  desc "Submit an uploaded build for App Store review, released in phases"
  lane :submit do |options|
    notes = app_store_notes(ENV.fetch("RELEASE_NOTES", ""))
    # Name every listing language: deliver prefers a language's
    # release_notes.txt over "default", and those would be stale.
    languages = Dir.glob("metadata/*/").map { |dir| File.basename(dir) } - ["review_information"]
    deliver(
      app_version: options.fetch(:version),
      build_number: options.fetch(:build_number),
      release_notes: (languages + ["default"]).to_h { |language| [language, notes] },
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      phased_release: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false },
      force: true, # no interactive HTML preview in CI
    )
  end
end
