# CI release tooling. Lanes read an App Store Connect API key from:
#   ASC_KEY_ID, ASC_ISSUER_ID - from App Store Connect > Users and Access > Integrations
#   ASC_KEY_PATH              - path to the downloaded AuthKey_<id>.p8
#
# Signing is cloud-managed: the archive is built unsigned and Xcode signs
# the export with Apple's cloud-managed distribution certificate using the
# API key, so no certificates or profiles live in CI.

default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight for internal testers"
  lane :beta do
    build_and_upload
  end

  private_lane :build_and_upload do
    key_id, issuer_id, key_path = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].map { |name| ENV.fetch(name) }
    # Stored in the lane context, where the App Store Connect actions below
    # pick it up.
    app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path)
    build_number = latest_testflight_build_number(initial_build_number: 0) + 1

    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path.shellescape} " \
           "-authenticationKeyID #{key_id.shellescape} -authenticationKeyIssuerID #{issuer_id.shellescape}"

    build_app(
      project: "JustASimpleDice.xcodeproj",
      scheme: "JustASimpleDice",
      configuration: "Release",
      export_method: "app-store",
      skip_codesigning: true,
      skip_profile_detection: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: auth,
      export_options: {
        signingStyle: "automatic",
        teamID: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
        manageAppVersionAndBuildNumber: false,
      },
      output_directory: "build",
    )

    upload_to_testflight(
      changelog: last_git_commit[:message].lines.first.strip,
      distribute_external: false,
    )
  end
end
